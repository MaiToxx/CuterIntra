{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Cuter Intra",
  "version": "1.0.8",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared-styles.css",
        "shared-themes.css",
        "theme-dark-v2.css",
        "theme-dark-v3.css",
        "theme-light-default-v3.css",
        "theme-light-v3.css"
      ],
      "matches": [
        "https://*.intra.42.fr/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cuter Intra"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "not_allowed",
  "host_permissions": [
    "https://api.betterintra.com/*",
    "https://*.intra.42.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.intra.42.fr/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.intra.42.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://api.betterintra.com/callback*"
      ],
      "js": [
        "auth-callback.js"
      ],
      "run_at": "document_end"
    }
  ]
}
